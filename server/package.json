{
  "name": "teerthanker-dental-server",
  "version": "1.0.0",
  "description": "Backend API server for Teerthanker Dental Care management system",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node build.js",
    "vercel-build": "echo 'Build completed for Vercel'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:payment": "node src/test/runPaymentTests.js",
    "test:payment:unit": "node src/test/runPaymentTests.js --category=unit",
    "test:payment:integration": "node src/test/runPaymentTests.js --category=integration",
    "test:payment:e2e": "node src/test/runPaymentTests.js --category=e2e",
    "test:payment:coverage": "node src/test/runPaymentTests.js --coverage",
    "test:auto-cancel": "node src/test/autoCancelTest.js",
    "generate-key": "node src/scripts/generateEncryptionKey.js",
    "create-admin": "node scripts/createAdmin.js",
    "seed-plans": "node src/scripts/seedPlans.js",
    "seed-availability": "node src/scripts/seedAvailabilityData.js",
    "init-db": "node scripts/init-fresh-database.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pidusage": "^3.0.2",
    "prom-client": "^15.1.0",
    "razorpay": "^2.9.2",
    "response-time": "^2.3.2",
    "twilio": "^5.8.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test/**",
      "!src/scripts/**",
      "!server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
