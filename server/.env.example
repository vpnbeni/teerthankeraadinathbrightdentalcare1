# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/teerthanker-dental-care
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/teerthanker-dental-care

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# MSG91 Configuration
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SMS Provider (twilio or msg91)
SMS_PROVIDER=twilio

# Email Configuration (Gmail)
EMAIL_FROM=noreply@teerthankerdentalcare.com
EMAIL_FROM_NAME=Teerthanker Dental Care
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_PASS=your-gmail-app-password

# CORS Origins
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Production URLs
PROD_CLIENT_URL=https://client.teerthankerdentalcare.com
PROD_ADMIN_URL=https://admin.teerthankerdentalcare.com
PROD_API_URL=https://api.teerthankerdentalcare.com

# Security Configuration (HIPAA Compliance)
ENCRYPTION_KEY=your-256-bit-encryption-key-in-hex-format
# Generate with: npm run generate-key

# Optional Security Settings
SESSION_TIMEOUT=1800000
MAX_SESSIONS_PER_USER=3
AUDIT_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=90
