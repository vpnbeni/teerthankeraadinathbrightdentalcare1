# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL
# Copy and paste these into your Vercel dashboard
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas - REQUIRED)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/teerthanker-dental-care

# JWT Configuration (REQUIRED - Generate secure keys)
JWT_SECRET=your-super-secure-256-bit-jwt-secret-key-here
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary Configuration (REQUIRED for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Configuration (REQUIRED for payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SMS Configuration - Choose ONE provider
SMS_PROVIDER=twilio

# MSG91 Configuration (Alternative SMS provider)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# Twilio Configuration (Recommended SMS provider)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration (REQUIRED for notifications)
EMAIL_FROM=noreply@teerthankerdentalcare.com
EMAIL_FROM_NAME=Teerthanker Dental Care
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_PASS=your-gmail-app-password

# Production URLs (Update with your actual domains)
CLIENT_URL=https://teerthankeraadinathbrightdentalcare.vercel.app
ADMIN_URL=https://teerthankeraadinathbrightdentalcare.vercel.app/admin
PROD_CLIENT_URL=https://teerthankeraadinathbrightdentalcare.vercel.app
PROD_ADMIN_URL=https://teerthankeraadinathbrightdentalcare.vercel.app/admin
PROD_API_URL=https://teerthankeraadinathbrightdentalcare.vercel.app/api

# CORS Origins
CORS_ORIGIN=https://teerthankeraadinathbrightdentalcare.vercel.app

# Security Configuration (HIPAA Compliance - REQUIRED)
ENCRYPTION_KEY=your-256-bit-encryption-key-in-hex-format

# Security Settings
SESSION_TIMEOUT=1800000
MAX_SESSIONS_PER_USER=3
AUDIT_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=90

# Frontend Environment Variables (Vite)
VITE_API_URL=https://teerthankeraadinathbrightdentalcare.vercel.app/api
VITE_API_BASE_URL=https://teerthankeraadinathbrightdentalcare.vercel.app
VITE_RAZORPAY_KEY_ID=rzp_test_tbHCcBCOBwdMeC
VITE_NODE_ENV=production
VITE_PROD_API_URL=https://teerthankeraadinathbrightdentalcare.vercel.app/api
VITE_APP_NAME=Teerthanker Dental Care
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
VITE_ENABLE_USER_MANAGEMENT=true
VITE_ENABLE_REPORTS=true
VITE_SESSION_TIMEOUT=30

# ===========================================
# INSTRUCTIONS FOR SETUP:
# ===========================================
# 1. Replace all placeholder values with your actual credentials
# 2. Generate JWT_SECRET: Use a 256-bit random string
# 3. Generate ENCRYPTION_KEY: Use a 64-character hex string
# 4. Update all domain URLs to match your actual domains
# 5. Set up MongoDB Atlas and get connection string
# 6. Configure Cloudinary account for file uploads
# 7. Set up Razorpay account for payments
# 8. Choose SMS provider (Twilio recommended) and configure
# 9. Set up Gmail app password for email notifications
# 10. In Vercel dashboard: Settings > Environment Variables > Add each variable